# Copy to .env for local runs. On Vercel, set these under Project Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: server-side only. Never put it in the web app or the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the web app's server sends as the X-API-Key header.
API_KEY=
