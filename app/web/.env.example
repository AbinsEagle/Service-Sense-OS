# Copy to .env.local for local runs; on Vercel set these in the project's Environment Variables.
# Without all three the app runs as a demo: it reads the device but can't sign in or save.
VITE_API_URL=https://<backend-project>.vercel.app
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon (public) key. Never the service_role key.
VITE_SUPABASE_ANON_KEY=
